# Copy to .env and fill in. The service reads .env from its working directory
# (or ENV_FILE); real environment variables always win over the file, so a
# deployment secret never has to live on disk.
#
# NEVER commit .env: it holds a credential that can read the private repository.

# --- GitHub source of truth (server-side only, never surfaced to clients) -----
GITHUB_TOKEN=github_pat_replace_me
GITHUB_OWNER=gamistudios
GITHUB_REPOSITORY=Agentisco
# GITHUB_REPO is accepted as an alias for GITHUB_REPOSITORY.

# Point this at internal/ghfake (cmd/mockgithub) to develop without a repository:
# GITHUB_API_BASE_URL=http://127.0.0.1:9100
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_TIMEOUT_SECONDS=20
RELEASES_PER_SYNC=30

# --- Background synchronisation ----------------------------------------------
SYNC_INTERVAL_SECONDS=60
SYNC_STARTUP_DELAY_SECONDS=0

# --- Large artifacts on a poor connection ------------------------------------
# DOWNLOAD_TIMEOUT_SECONDS is the whole budget for one channel's pass, including
# the APK transfer. STALL_TIMEOUT_SECONDS abandons a transfer only after it has
# delivered no bytes at all for that long, so a slow link still finishes.
DOWNLOAD_TIMEOUT_SECONDS=3600
STALL_TIMEOUT_SECONDS=30

# --- Storage ------------------------------------------------------------------
# Cached APKs + metadata database. Must survive restarts, or every artifact is
# re-downloaded from GitHub on the first pass.
STORAGE_PATH=./data

# --- HTTP surface ---------------------------------------------------------------
PORT=8080
# Absolute origin used to build download URLs. Leave empty to derive it from the
# request (X-Forwarded-Proto/Host), which is what most PaaS hosts need.
PUBLIC_BASE_URL=
READ_TIMEOUT_SECONDS=30
# 0 removes the write deadline: an APK stream to a phone may be long-lived.
WRITE_TIMEOUT_SECONDS=0
IDLE_TIMEOUT_SECONDS=120
RATE_LIMIT_RPS=10
RATE_LIMIT_BURST=40
ENABLE_LANDING=true

# --- Logging --------------------------------------------------------------------
LOG_LEVEL=info
LOG_FORMAT=json

# --- Local development only -------------------------------------------------------
# ENV_FILE=/absolute/path/to/.env
