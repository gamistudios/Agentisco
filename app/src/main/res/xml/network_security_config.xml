<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
      The app's own provider/update traffic is HTTPS. Only the device loopback
      is allowed to speak cleartext so the Run & Build preview WebView can load
      the local dev server started inside the embedded Linux environment.
    -->
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
